# Copy to .env and fill in. NEVER commit .env.
# Every key here must exist in app/config.py Settings.

# --- App ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- Postgres (local docker-compose; swap for Neon URL in production) ---
# Port 5433, not 5432 — see the comment in docker-compose.yml. If you have no
# native PostgreSQL installed, 5432 would work too, but 5433 is safe either way.
DATABASE_URL=postgresql+psycopg://ragsaas:ragsaas@localhost:5433/ragsaas

# --- Redis (Celery broker + result backend, Phase 2) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=              # empty for local; required for Qdrant Cloud
QDRANT_COLLECTION=chunks

# --- Provider selection (Phase 1) ---
# Swapping providers = editing these lines, nothing else.
LLM_PROVIDER=gemini          # gemini | groq | ollama | anthropic | openai
EMBEDDING_PROVIDER=bge_local # bge_local | openai
RERANK_PROVIDER=bge_local    # bge_local | cohere | noop

# --- Provider credentials (Phase 1; leave blank until that provider is used) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# --- Auth (Phase 2) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Public keys used to verify session-token signatures. Clerk publishes these at
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# The `iss` claim required on every token. Set this — without it, a validly
# signed token from anyone else's Clerk instance is only rejected by accident.
CLERK_ISSUER=
CLERK_JWKS_CACHE_SECONDS=3600

# --- Uploads (Phase 2) ---
# Must be reachable by BOTH the API and the Celery worker: the API writes the
# file, the worker reads it. Two different paths means every ingestion fails
# with "uploaded file is missing on disk".
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_BYTES=26214400    # 25MB

# --- Chat (Phase 3) ---
# Automatic failover when the primary LLM fails with a RETRYABLE error (rate
# limit, timeout, 5xx) and has not yet produced a token. Leave blank to disable
# failover entirely. Must not equal LLM_PROVIDER — a provider cannot be its own
# fallback, and the factory degrades to no failover rather than pretending.
LLM_FALLBACK_PROVIDER=groq   # gemini | groq | ollama | anthropic | openai | (blank)

# How many previous messages are replayed to the model each turn. Every one of
# them is re-sent on every message, so this trades follow-up quality directly
# against latency and cost. 6 is three exchanges.
CHAT_HISTORY_MESSAGES=6

# Per-widget-key (or per-org, on the dashboard) token bucket. PER_MINUTE is the
# sustained refill rate; BURST is how many messages may arrive back-to-back
# before throttling starts. Burst above rate is deliberate: real users send a
# few messages quickly and then read.
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_BURST=10

# Browser origins allowed to call the API. "*" is correct while every credential
# travels in a header (X-Bot-Key, Authorization) and never in a cookie — the
# widget ships on customer domains we do not know in advance. Introduce cookie
# auth and this must become an explicit comma-separated list the same day.
CORS_ORIGINS=["*"]

# --- Billing (Phase 6, Stripe TEST mode only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
